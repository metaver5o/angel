# Angel staging stack. Copy to .env and fill in; .env is gitignored.
#   cp .env.example .env

# Your Counterparty Core v2 API (v11+ with taproot envelopes), host:port, no
# scheme. The proxy forwards /cp/* here. From inside the container,
# host.docker.internal reaches services running on the host machine; if
# Counterparty runs as another container, use its service name on a shared
# docker network instead. Must be on the same network (mainnet/testnet4) you
# want the page to mint on — the page reads the network from the node.
CP_UPSTREAM=host.docker.internal:4000

# Token the in-page Deploy button must send (X-Deploy-Token). Generate:
#   openssl rand -hex 16
DEPLOY_TOKEN=

# Optional: only if you switch the tunnel to a named/account Cloudflare tunnel.
# TUNNEL_TOKEN=
