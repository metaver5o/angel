# Bitcoin Core (txindex=1) and Counterparty Core the mint backend talks to.
# From inside the container, host.docker.internal reaches services on your Mac.
BTC_RPC_URL=http://host.docker.internal:8332
BTC_RPC_USER=rpc_user
BTC_RPC_PASSWORD=rpc_password
CP_API_URL=http://host.docker.internal:4000

# Which chain. mainnet | testnet4 | signet  (drives wallet + explorer links)
BTC_NETWORK=mainnet

COUNTER_DATA_DIR=/data

# Optional: AI assist routes (/ai/*). Not needed to mint.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: only if you switch the tunnel to a named/account tunnel.
# TUNNEL_TOKEN=
