# Single front door for the tunnel.
#
#   /cp/*                 -> your Counterparty Core node (CP_UPSTREAM), with
#                            CORS so the GitHub Pages copy can use it too. Only
#                            the handful of routes the mint needs are let through.
#   /__version /__deploy  -> deployer sidecar (footer version + Deploy button)
#   /__event /__events    -> deployer sidecar (page activity + error log)
#   everything else       -> the page, served straight from web/
#
# Every request is logged as JSON to stdout: `docker compose logs -f proxy`.
:80 {
	log {
		output stdout
		format json
	}

	@cp path /cp/*
	handle @cp {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"

		@preflight method OPTIONS
		handle @preflight {
			respond 204
		}

		# API root (network), compose, balances, asset lookup, relay + lookup of a transaction.
		@allowed path_regexp ^/cp/v2(/|/addresses/[^/]+/compose/issuance|/addresses/[^/]+/balances(/[^/]+)?|/addresses/[^/]+/assets/owned|/assets/[^/]+|/bitcoin/transactions(/[0-9a-fA-F]{64})?)?$
		handle @allowed {
			uri strip_prefix /cp
			reverse_proxy {$CP_UPSTREAM}
		}

		handle {
			respond `{"error":"not allowed"}` 403
		}
	}

	@deploy path /__version /__deploy /__event /__events /__errors
	handle @deploy {
		reverse_proxy deployer:8090
	}

	handle {
		root * /srv
		# Always the latest push: wallet-signing bugs on a cached page are hard to see.
		header Cache-Control no-store
		file_server
	}
}
